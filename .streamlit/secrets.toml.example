# Copy this file to .streamlit/secrets.toml for local development, or run:
#   python scripts/create_streamlit_secrets.py
# Never commit the populated secrets.toml file.

MONGODB_URI = "mongodb+srv://USERNAME:PASSWORD@HOST/?retryWrites=true&w=majority"
MONGODB_DATABASE = "qaqc_dashboard"
QAQC_REQUIRE_MONGODB_TLS = "true"
QAQC_BOOTSTRAP_ADMIN_USERNAME = "admin"
QAQC_BOOTSTRAP_ADMIN_EMAIL = "security-admin@example.com"
QAQC_BOOTSTRAP_ADMIN_PASSWORD = "replace_with_a_unique_14_plus_character_password"
CLOUDINARY_URL = "cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
QAQC_MASTER_WORKBOOK_PUBLIC_ID = "qaqc-dashboard/data/QAQC_Master.xlsx"
QAQC_ACTIVITY_WORKBOOK_PUBLIC_ID = "qaqc-dashboard/activity-logs/QAQC_Activity_Log.xlsx"
OPENAI_API_KEY = "replace_with_openai_api_key"
OPENAI_SUPPORT_MODEL = "gpt-5-mini"
QAQC_ENABLE_AI_SUPPORT = "false"
QAQC_ENV = "production"
QAQC_ALLOWED_HOSTS = "api.your-qaqc-dashboard.example.com"
QAQC_FORCE_HTTPS = "true"
QAQC_COOKIE_SECURE = "true"

# Gmail approval notifications. Use a Google App Password, never the Gmail account password.
QAQC_GMAIL_ADDRESS = "fortunesundayske@gmail.com"
QAQC_GMAIL_APP_PASSWORD = "replace_with_16_character_google_app_password"

# Exchange Online / Microsoft Graph approval and support notifications.
# The Azure application requires Mail.Send application permission with admin consent.
QAQC_EXCHANGE_TENANT_ID = "replace_with_microsoft_tenant_id"
QAQC_EXCHANGE_CLIENT_ID = "replace_with_azure_application_client_id"
QAQC_EXCHANGE_CLIENT_SECRET = "replace_with_azure_application_secret"
QAQC_EXCHANGE_SENDER = "fortune.kpakue@evomeclimited.com"
QAQC_APP_URL = "https://qualitydashboard-evomec.streamlit.app/"
QAQC_SUPPORT_EMAIL = "fortune.kpakue@evomeclimited.com"
