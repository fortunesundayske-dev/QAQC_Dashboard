MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/?retryWrites=true&w=majority
MONGODB_DATABASE=qaqc_dashboard
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
QAQC_MASTER_WORKBOOK_PUBLIC_ID=qaqc-dashboard/data/QAQC_Master.xlsx
QAQC_ACTIVITY_WORKBOOK_PUBLIC_ID=qaqc-dashboard/activity-logs/QAQC_Activity_Log.xlsx
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_SUPPORT_MODEL=gpt-5-mini

# SMTP is required for approval and support email notifications.
QAQC_SMTP_HOST=smtp.example.com
QAQC_SMTP_PORT=587
QAQC_SMTP_USER=mailer@example.com
QAQC_SMTP_PASSWORD=replace_with_secret
QAQC_SMTP_FROM=mailer@example.com
QAQC_SMTP_STARTTLS=1
QAQC_SMTP_SSL=0
# Optional: included as the sign-in link in account approval emails.
QAQC_APP_URL=https://your-qaqc-dashboard.example.com
QAQC_SUPPORT_EMAIL=support@example.com
